    "@sanity/vision": "^6.12.0",
    "@sentry/nextjs": "^8.34.0",
    "@tailwindcss/typography": "^0.5.15",
    "@uiw/react-md-editor": "^4.0.4",
    "class-variance-authority": "^0.7.0",
